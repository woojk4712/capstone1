KEPCO_SERVICE_KEY=
KEPCO_URL=
ADMIN_TOKEN=
DATABASE_URL=
STATE_TTL_MINUTES=15
COLLECT_INTERVAL_SECONDS=600
# Verify provider guide + authenticated response before enabling mappings.
ME_MAPPING_VERIFIED=false
ME_STATUS_MAP={}
ME_FAST_TYPES=[]
KEPCO_FIELD_MAP={}
KEPCO_STATUS_MAP={}
KEPCO_KEY_PARAM=apiKey
KEPCO_ITEMS_PATH=data
